# ============================================================
# APROXIMA (APRXM) — Environment Variables
# Copy to .env and fill in your values. NUNCA commitar .env.
# ============================================================

# --- PostgreSQL (Neon Serverless) ---
DATABASE_URL=postgresql+asyncpg://neondb_owner:SUA_SENHA@ep-xxxx-pooler.c-6.us-east-1.aws.neon.tech/neondb?ssl=true
# Conexao SEM pooler -- usada por VACUUM (app/routers/admin.py, ti.py). Nao e legado.
DATABASE_URL_DIRECT=postgresql://neondb_owner:SUA_SENHA@ep-xxxx.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require
# Default 3/7 e seguro pro Vercel serverless. Na VM (1 processo fixo), subir
# (ex: 10/20) -- ver docs/superpowers/plans/2026-09-12-migracao-aprxm-execucao.md Fase C.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7

# --- Neon OLAP (destino do gold do ETL -> Power BI) ---
DATAWAREHOUSE_APRXM_DATABASE_URL=postgresql+asyncpg://neondb_owner:SUA_SENHA@ep-yyyy-pooler.c-7.us-east-1.aws.neon.tech/neondb?ssl=true

# --- Security ---
SECRET_KEY=gere_com_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage (Supabase) ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
SUPABASE_STORAGE_BUCKET=aprxm-midia

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,https://aprxm.vercel.app

# --- App ---
APP_ENV=development
APP_NAME=APROXIMA
APP_VERSION=1.0.0
DELIVERY_FEE_DEFAULT=2.50

# --- Painel de Governanca (painel-aprxm) — auth isolada do app operacional ---
PAINEL_SECRET_KEY=gere_com_python_secrets_token_hex_32
PAINEL_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- SMTP (e-mails transacionais) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=app_password_do_gmail
SMTP_FROM=Associação de Moradores <seu_email@gmail.com>

# --- Cron (OBRIGATORIO em producao — o boot falha se vazio, ver
# app/config.py:validate_production_config) ---
CRON_SECRET=gere_um_segredo_forte

# --- Groq (LLM — agente Simplifica) ---
GROQ_API_KEY=

# --- Cloudflare R2 (data lake bronze/prata/ouro do ETL) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aprxm-datalake

# --- WebAuthn/passkeys (dominio do FRONTEND — nao muda com a migracao do backend) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=APRXM
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Web Push (VAPID) — sem VAPID_PRIVATE_KEY, push falha silenciosamente ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:seu_email@dominio.org
